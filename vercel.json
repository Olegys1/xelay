{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/supabase/auth/v1/:path*",
      "destination": "https://baohfpadxvhqhhjjqtil.supabase.co/auth/v1/:path*"
    },
    {
      "source": "/api/supabase/rest/v1/:path*",
      "destination": "https://baohfpadxvhqhhjjqtil.supabase.co/rest/v1/:path*"
    },
    {
      "source": "/community-rules",
      "destination": "/legal/community-rules.html"
    },
    {
      "source": "/terms",
      "destination": "/legal/terms.html"
    },
    {
      "source": "/refund-policy",
      "destination": "/legal/refund-policy.html"
    },
    {
      "source": "/contacts",
      "destination": "/legal/contacts.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/legal/privacy-policy.html"
    },
    {
      "source": "/personal-data-consent",
      "destination": "/legal/personal-data-consent.html"
    },
    {
      "source": "/api/notifications/retry",
      "destination": "/api/notifications/email?xelay_notification_route=retry"
    },
    {
      "source": "/api/seminars/draft",
      "destination": "/api/groups/recognize-timetable?xelay_ai_route=seminar"
    },
    {
      "source": "/api/groups/homework-draft",
      "destination": "/api/groups/recognize-timetable?xelay_ai_route=homework"
    },
    {
      "source": "/guides",
      "destination": "/guides/index.html"
    },
    {
      "source": "/guides/",
      "destination": "/guides/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|legal/|guides/|push-sw\\.js$|manifest\\.webmanifest$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-keQlrBQkqSEV/ArIUWvDI8ncq82B7fKJ55MEQHIDQro=' 'sha256-ZLXM8xM8tqCjyJIHbuwLTRn4lirEXe+85qxiRGp6VlA='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' https: data: blob:; media-src 'self' https: data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src https://secure.wayforpay.com; form-action 'self' https://secure.wayforpay.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=(self \"https://secure.wayforpay.com\")"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/supabase/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
