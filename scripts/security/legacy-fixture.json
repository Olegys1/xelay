  "functions": [
    "CREATE OR REPLACE FUNCTION public.increment_profile_rating(profile_id uuid)\n RETURNS void\n LANGUAGE sql\n SECURITY DEFINER\nAS $function$\r\n  update profiles\r\n  set rating = coalesce(rating, 0) + 1\r\n  where id = profile_id;\r\n$function$\n"
