# Example only. Add actual values to Vercel > Project > Settings > Environment Variables.
# Never commit secrets or add a VITE_ prefix to any server secret.
# Safe initial state: checkout and recurring charges are off.
BILLING_MODE=disabled
BILLING_CHECKOUT_ENABLED=false
BILLING_TEST_ISOLATED=false
WAYFORPAY_LIVE_APPROVED=false
# Separate payment purpose: enable only after SQL 202610060001 and approval
# of voluntary team support by WayForPay and the merchant's accountant.
# Disabling this pauses NEW support orders; callbacks/refunds keep working.
TEAM_SUPPORT_ENABLED=false

# Canonical HTTPS origin and its matching hostname, without a path.
XELAY_PUBLIC_URL=https://www.xelay.ink
WAYFORPAY_MERCHANT_DOMAIN=www.xelay.ink

# The same Supabase project used by the frontend; actual keys go only in Vercel.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Leave empty until using an isolated test merchant or an approved live merchant.
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_SECRET_KEY=

# Email notifications: configure a verified sender and a separate webhook secret.
# Keep false on Preview/Development. Auth confirmation/reset use Supabase SMTP.
NOTIFICATION_EMAIL_ENABLED=false
RESEND_API_KEY=
XELAY_EMAIL_FROM=Xelay <notifications@xelay.ink>
NOTIFICATION_WEBHOOK_SECRET=

# Independent secret for the bounded detached-file cleanup worker, POST only.
# Schedule only after staging/backup and SQL 004-009; do not use live keys in Preview.
SECURITY_MAINTENANCE_SECRET=

# Existing frontend variables are configured separately in Vercel:
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_KEY
