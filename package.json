  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:opportunities": "node scripts/preview-opportunities.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test:security": "npm run build && node --test scripts/security/*.test.mjs",
    "security:headers": "node scripts/security/update-headers.mjs",
    "lint:css": "stylelint \"src/**/*.css\" --fix --quiet",
    "lint:js": "eslint . --ext ts,tsx --report-unused-disable-directives",
