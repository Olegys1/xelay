{
  "name": "xelay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve-app.mjs",
    "dev:student": "node scripts/preview-student-workspace.mjs",
    "build:student-preview": "node scripts/preview-student-workspace.mjs --build",
    "dev:opportunities": "node scripts/preview-opportunities.mjs",
    "build": "node scripts/build-app.mjs",
    "preview": "node scripts/serve-app.mjs --preview",
    "test:security": "npm run build && node --test scripts/security/*.test.mjs",
    "security:headers": "node scripts/security/update-headers.mjs",
    "lint:css": "node scripts/lint-css.mjs",
    "lint:js": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:types": "tsc --noEmit",
    "check:css-vars": "node scripts/check-css-variables.js",
    "check:css-classes": "node scripts/check-css-classes.js",
    "lint": "bun run lint:types && bun run lint:js && bun run lint:css && bun run check:css-vars && bun run check:css-classes"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/oxide": "4.3.5",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "10.6.1",
    "css-tree": "3.2.1",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.5",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.13",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-router": "^1.170.46",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "katex": "0.19.0",
    "lucide-react": "^1.8.0",
    "pdfjs-dist": "6.4.299",
    "tailwind-merge": "^3.5.0",
    "web-push": "3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
