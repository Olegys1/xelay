    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.28",
    "stylelint": "^17.7.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2",
    "vite": "8.1.6"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
