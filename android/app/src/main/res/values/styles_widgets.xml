<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="XelayWidgetRoot">
        <item name="android:background">@drawable/widget_background</item>
        <item name="android:padding">8dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clipToPadding">true</item>
    </style>
    <style name="XelayWidgetText" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="XelayWidgetBrand" parent="XelayWidgetText">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">-0.045</item>
        <item name="android:textColor">@color/widget_primary</item>
    </style>
    <style name="XelayWidgetTitle" parent="XelayWidgetText">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="XelayWidgetSubtitle" parent="XelayWidgetText">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
    </style>
    <style name="XelayWidgetRow">
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/widget_row_background</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
    </style>
    <style name="XelayWidgetRowTitle" parent="XelayWidgetText">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="XelayWidgetRowSubtitle" parent="XelayWidgetSubtitle">
        <item name="android:textSize">10sp</item>
    </style>
</resources>
