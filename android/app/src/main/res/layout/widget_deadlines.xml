<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" style="@style/XelayWidgetRoot" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginEnd="4dp" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/widget_brand" style="@style/XelayWidgetBrand" android:layout_width="match_parent" android:layout_height="wrap_content" android:importantForAccessibility="no" android:text="@string/widget_brand" />
            <TextView android:id="@+id/widget_title" style="@style/XelayWidgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_deadlines_title" />
            <TextView android:id="@+id/widget_subtitle" style="@style/XelayWidgetSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_group_placeholder" />
        </LinearLayout>
        <ImageButton android:id="@+id/widget_refresh" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/widget_refresh_background" android:contentDescription="@string/widget_refresh_description" android:padding="12dp" android:scaleType="centerInside" android:src="@drawable/widget_ic_refresh" />
    </LinearLayout>
    <TextView android:id="@+id/widget_current_caption" style="@style/XelayWidgetSubtitle" android:layout_width="match_parent" android:layout_height="14dp" android:gravity="center_vertical" android:text="@string/widget_current_caption" android:visibility="gone" />
    <FrameLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/widget_rows" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:id="@+id/widget_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <FrameLayout android:layout_width="14dp" android:layout_height="match_parent" android:importantForAccessibility="no">
                <TextView android:id="@+id/widget_row_1_line" android:layout_width="1dp" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:background="@color/widget_border" />
                <TextView android:id="@+id/widget_row_1_dot" android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="7dp" android:background="@drawable/widget_light_dot" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="5dp" android:paddingEnd="5dp">
                <TextView android:id="@+id/widget_row_1_title" style="@style/XelayWidgetRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/widget_row_1_subtitle" style="@style/XelayWidgetRowSubtitle" android:maxLines="2" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_row_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <FrameLayout android:layout_width="14dp" android:layout_height="match_parent" android:importantForAccessibility="no">
                <TextView android:id="@+id/widget_row_2_line" android:layout_width="1dp" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:background="@color/widget_border" />
                <TextView android:id="@+id/widget_row_2_dot" android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="7dp" android:background="@drawable/widget_light_dot" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="5dp" android:paddingEnd="5dp">
                <TextView android:id="@+id/widget_row_2_title" style="@style/XelayWidgetRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/widget_row_2_subtitle" style="@style/XelayWidgetRowSubtitle" android:maxLines="2" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_row_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
            <FrameLayout android:layout_width="14dp" android:layout_height="match_parent" android:importantForAccessibility="no">
                <TextView android:id="@+id/widget_row_3_line" android:layout_width="1dp" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:background="@color/widget_border" />
                <TextView android:id="@+id/widget_row_3_dot" android:layout_width="7dp" android:layout_height="7dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="7dp" android:background="@drawable/widget_light_dot" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="5dp" android:paddingEnd="5dp">
                <TextView android:id="@+id/widget_row_3_title" style="@style/XelayWidgetRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/widget_row_3_subtitle" style="@style/XelayWidgetRowSubtitle" android:maxLines="2" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/widget_empty" style="@style/XelayWidgetSubtitle" android:layout_width="match_parent" android:layout_height="match_parent" android:ellipsize="end" android:gravity="center" android:maxLines="3" android:text="@string/widget_loading" android:textSize="11sp" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_updated" style="@style/XelayWidgetSubtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/widget_not_updated" android:textSize="9sp" />
        <TextView android:id="@+id/widget_open" style="@style/XelayWidgetTitle" android:layout_width="wrap_content" android:layout_height="match_parent" android:background="@drawable/widget_open_background" android:contentDescription="@string/widget_open_description" android:gravity="center" android:minWidth="48dp" android:paddingStart="7dp" android:paddingEnd="7dp" android:text="@string/widget_open_label" android:textColor="@color/widget_primary" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
